{
  "name": "blade-vale-server",
  "version": "0.1.0",
  "private": true,
  "type": "commonjs",
  "description": "Blade Vale backend — persists named-character careers and (later) the always-on living world. SQLite via better-sqlite3.",
  "scripts": {
    "migrate": "node server/db.js --migrate",
    "seed": "node server/seed.js",
    "server": "node server/index.js",
    "dev": "node --watch server/index.js",
    "bot": "node bot/bot.js",
    "perf": "node perf/run.js",
    "perf:update": "node perf/run.js --update"
  },
  "dependencies": {
    "better-sqlite3": "^11.8.1"
  },
  "devDependencies": {
    "puppeteer-core": "^24.43.1"
  }
}
