{
  // Blade Vale on Cloudflare Workers — the whole of bladevale.com in one Worker.
  //
  //   * the game client, as static assets: dist/, assembled by tools/build-site.js (an allowlist, so the
  //     upload is the client and nothing else — the repo root would sweep in node_modules, server/, the
  //     databases and the docs)
  //   * /api/v1/*  — accounts, sessions, the arena career and the marketplace, on the D1 database below
  //   * /coop      — the co-op relay, one Durable Object holding every player's WebSocket
  //
  // worker/index.js is the port of server/ cut down to what Arena Fights uses; the living world does
  // not run here (see VISION.md). The D1 schema is worker/schema.sql, applied by hand:
  //   npx wrangler d1 execute blade-vale --remote --file worker/schema.sql
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "blade-vale",
  "main": "worker/index.js",
  "compatibility_date": "2026-09-01",
  "build": {
    "command": "node tools/build-site.js",
    "watch_dir": "worker"            // (with a custom build, wrangler dev only watches ./src unless told)
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*", "/coop"]
  },
  "d1_databases": [
    { "binding": "DB", "database_name": "blade-vale", "database_id": "77cd12aa-1938-4f4f-999a-35ca4d43f3d5" }
  ],
  "durable_objects": {
    "bindings": [{ "name": "RELAY", "class_name": "Relay" }]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["Relay"] }
  ],
  // the vale's men fight among themselves: a bout or two every quarter hour (worker/index.js scheduled → simulateRound)
  "triggers": { "crons": ["*/15 * * * *"] },
  "observability": {
    "enabled": true
  }
}
